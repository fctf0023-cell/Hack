<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Axiom Loader</title>

<style>
*{box-sizing:border-box}
body{
    margin:0;
    min-height:100vh;
    display:grid;
    place-items:center;
    background:#090909;
    color:#fff;
    font-family:Arial,sans-serif;
    overflow:hidden;
}

.loader{
    width:100%;
    height:100vh;
    display:grid;
    place-items:center;
}

.spinner{
    width:58px;
    height:58px;
    border:5px solid #222;
    border-top-color:#fff;
    border-radius:50%;
    animation:spin .8s linear infinite;
}

@keyframes spin{
    to{transform:rotate(360deg)}
}

.launcher{
    position:fixed;
    left:24px;
    bottom:24px;
    width:64px;
    height:64px;
    border-radius:50%;
    border:2px solid #555;
    background:#151515;
    color:white;
    cursor:pointer;
    display:none;
    font-weight:bold;
    box-shadow:0 0 25px #000;
}

.panel{
    width:min(390px,90vw);
    max-height:85vh;
    overflow:auto;
    padding:20px;
    border:1px solid #333;
    border-radius:16px;
    background:#111;
    box-shadow:0 20px 60px #000;
    display:none;
}

h2{margin:0 0 15px}

.keybox{
    display:flex;
    gap:8px;
}

input{
    flex:1;
    min-width:0;
    padding:11px;
    border:1px solid #333;
    border-radius:8px;
    background:#080808;
    color:#fff;
    outline:none;
}

button{
    border:1px solid #333;
    border-radius:8px;
    padding:10px 13px;
    background:#1b1b1b;
    color:#fff;
    cursor:pointer;
}

button:hover{background:#292929}

#error{
    min-height:18px;
    margin-top:8px;
    font-size:12px;
}

.menu{
    display:none;
    margin-top:15px;
}

.row{
    display:grid;
    grid-template-columns:1fr auto 90px;
    gap:8px;
    align-items:center;
    padding:9px 0;
    border-bottom:1px solid #222;
}

.row:last-child{border-bottom:0}

.toggle{
    width:42px;
    padding:7px 0;
}

.toggle.active{
    background:#fff;
    color:#000;
}

.value{
    width:90px;
}
</style>
</head>

<body>

<div class="loader" id="loader">
    <div class="spinner"></div>
</div>

<button class="launcher" id="launcher">AX</button>

<section class="panel" id="panel">

    <h2>Axiom Menu</h2>

    <div class="keybox" id="keyArea">
        <input id="key" type="password" placeholder="Nhập key">
        <button id="unlock">Mở</button>
    </div>

    <div id="error"></div>

    <div class="menu" id="menu">

        <div class="row">
            <span>Tốc độ</span>
            <button class="toggle" data-feature="speed">OFF</button>
            <input class="value" type="number" placeholder="Tốc độ">
        </div>

        <div class="row">
            <span>Nhảy</span>
            <button class="toggle" data-feature="jump">OFF</button>
            <input class="value" type="number" placeholder="Độ cao">
        </div>

        <div class="row">
            <span>Nhảy liên tục</span>
            <button class="toggle" data-feature="infiniteJump">OFF</button>
            <span></span>
        </div>

        <div class="row">
            <span>Bay</span>
            <button class="toggle" data-feature="fly">OFF</button>
            <input class="value" type="number" placeholder="Độ cao">
        </div>

        <div class="row">
            <span>ESP</span>
            <button class="toggle" data-feature="esp">OFF</button>
            <span></span>
        </div>

        <div class="row">
            <span>Thông tin</span>
            <button class="toggle" data-feature="info">OFF</button>
            <span></span>
        </div>

        <div class="row">
            <span>X-Ray</span>
            <button class="toggle" data-feature="xray">OFF</button>
            <span></span>
        </div>

        <div class="row">
            <span>Thu nhỏ</span>
            <button class="toggle" data-feature="small">OFF</button>
            <input class="value" type="number" placeholder="Scale">
        </div>

        <div class="row">
            <span>Phóng to</span>
            <button class="toggle" data-feature="large">OFF</button>
            <input class="value" type="number" placeholder="Scale">
        </div>

    </div>
</section>

<script>
"use strict";

const KEY = "2014";

const loader  = document.getElementById("loader");
const launcher = document.getElementById("launcher");
const panel   = document.getElementById("panel");
const keyArea = document.getElementById("keyArea");
const keyInput = document.getElementById("key");
const unlock = document.getElementById("unlock");
const error = document.getElementById("error");
const menu = document.getElementById("menu");

const state = Object.create(null);

setTimeout(() => {
    loader.style.display = "none";
    launcher.style.display = "grid";
}, 1400);

launcher.addEventListener("click", () => {
    panel.style.display =
        panel.style.display === "block" ? "none" : "block";
});

unlock.addEventListener("click", unlockMenu);

keyInput.addEventListener("keydown", e => {
    if(e.key === "Enter") unlockMenu();
});

function unlockMenu(){
    if(keyInput.value !== KEY){
        error.textContent = "Key không đúng.";
        return;
    }

    error.textContent = "";
    keyArea.style.display = "none";
    menu.style.display = "block";
}

document.querySelectorAll(".toggle").forEach(button => {
    button.addEventListener("click", () => {
        const feature = button.dataset.feature;
        state[feature] = !state[feature];

        button.classList.toggle("active", state[feature]);
        button.textContent = state[feature] ? "ON" : "OFF";

        /*
         * Đây là điểm kết nối adapter của từng game.
         * Không giả lập tác động lên game nếu game không cung cấp API.
         */
        console.log({
            feature,
            enabled: state[feature]
        });
    });
});
</script>

</body>
</html>
